{
  "$comment": "Single source of truth for pipeline constants shared by desktop (Python) and Android (Kotlin). Desktop tests assert parity with these values; the Android build copies this file into its assets.",
  "version": 2,
  "defaults": {
    "color": "#FFFFFF",
    "sensitivity": 60,
    "softness": 20,
    "aggressive": false,
    "animated": false,
    "include_face": false,
    "speed": "quality",
    "target": "female",
    "gender_threshold": 70,
    "uncertain_policy": "censor",
    "fill": "color"
  },
  "thresholds": {
    "skin_on": { "strict": 0.72, "sensitive": 0.30, "aggressive_bonus": 0.08 },
    "nudenet_min_score": { "strict": 0.50, "sensitive": 0.20 },
    "person_min_score": { "strict": 0.45, "sensitive": 0.25 },
    "face_min_score": 0.5,
    "min_face_px": 14,
    "face_exclusion": 0.35,
    "skin_color": { "max_blue_over_red": 6, "min_luma": 28 },
    "person_gate": 0.3,
    "min_body_area": 0.02
  },
  "roi": { "side_scale": 1.15, "paste_pad": 0.08, "min_side_px": 24, "max_frame_ratio": 0.9, "full_every_det": 2 },
  "refine": { "radius": 0.004, "eps": 0.004, "color_band": 0.008, "color_keep": 0.85 },
  "neckline": {
    "band_half_width": 0.6, "band_height": 0.55, "probe_half_width": 0.35, "probe_height": 0.6,
    "cleavage_min_fill": 0.12, "cleavage_start": 0.55,
    "speck_person_frac": 0.002, "speck_frame_frac": 0.0002
  },
  "gender": {
    "vote_factor": 0.35,
    "max_logit": 6.0,
    "min_votes": 6,
    "min_weight": 3.0,
    "votes_before_slowdown": 12,
    "reclassify_seconds": 1.0,
    "male_min_confidence": 0.8,
    "child_max_age": 7,
    "min_age_votes": 6
  },
  "tracking": {
    "fuser_memory": 0.4,
    "fuser_lift": 0.35,
    "fuser_lift_aggressive": 0.5,
    "hysteresis_off_ratio": 0.6,
    "person_lost_seconds": 1.5,
    "reid_gallery_seconds": 12,
    "reid_min_similarity": 0.72,
    "region_max_misses": 3,
    "scene_cut_threshold": 0.45
  },
  "speed_presets": {
    "quality": { "seg_stride": 1, "det_stride": 2 },
    "balanced": { "seg_stride": 2, "det_stride": 3 },
    "fast": { "seg_stride": 4, "det_stride": 6 }
  },
  "sensitive_labels": ["BUTTOCKS_EXPOSED", "FEMALE_BREAST_EXPOSED", "FEMALE_GENITALIA_EXPOSED", "ANUS_EXPOSED", "MALE_GENITALIA_EXPOSED"],
  "aggressive_extra_labels": ["MALE_BREAST_EXPOSED", "BELLY_EXPOSED", "ARMPITS_EXPOSED", "FEMALE_BREAST_COVERED", "FEMALE_GENITALIA_COVERED", "BUTTOCKS_COVERED"],
  "ownership_box_pad": 0.06,
  "owner_reach": 0.12,
  "unassigned_min_area": 0.001,
  "unassigned_min_area_with_people": 0.004,
  "analysis_max_side": 768,
  "mask_max_side": 768,
  "person_masks": {
    "$comment": "MobileSAM outline per person (box prompt): decides which person every skin pixel belongs to. Refreshed on detection frames at most every every_sec, carried by the motion in between. clip_logit drops skin clearly outside every outline; off (-1000): outlines of people lying in bed are often incomplete and clipping removed real skin (measured).",
    "video_size": 512,
    "photo_size": 1024,
    "every_sec": 0.5,
    "speeds": ["quality", "balanced"],
    "owner_min_logit": 0.0,
    "clip_logit": -1000.0
  }
}
